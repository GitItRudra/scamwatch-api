{
  "name": "scamwatch-api",
  "version": "1.0.0",
  "description": "REST API for reporting scams and assessing the risk of phone numbers, UPI IDs, emails, URLs and bank accounts",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed.js --demo",
    "test": "jest",
    "seed:bulk": "node scripts/seedBulk.js",
    "test:e2e": "node scripts/e2e.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "joi": "^18.2.9",
    "js-yaml": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  }
}
